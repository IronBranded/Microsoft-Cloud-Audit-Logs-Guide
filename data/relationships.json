{
  "schema_version": "1.0.0",
  "notes": "Evidence-oriented pivots between catalog entries. A relationship says where an investigator can look next and on what fields; it never asserts that one event caused another. pivot_on lists shared attributes; values marked 'Verification required' still need a documented field name.",
  "relationships": [
    {
      "id": "rel-signin-to-audit",
      "from": "entra-sign-in-logs",
      "to": "entra-audit-logs",
      "type": "Pivot",
      "description": "After establishing how an identity signed in, check which directory changes the same identity made in the same window.",
      "pivot_on": ["Actor (user, service principal, or agent identity)", "Time window"],
      "source_ids": ["src-entra-monitoring-overview"],
      "verified": true
    },
    {
      "id": "rel-audit-to-activity",
      "from": "entra-audit-logs",
      "to": "azure-activity-log",
      "type": "Pivot",
      "description": "Directory changes and Azure management operations are recorded separately. Check whether the same identity also performed Azure Resource Manager operations.",
      "pivot_on": ["Actor identity", "Time window"],
      "source_ids": ["src-entra-audit-logs-concept", "src-activity-log"],
      "verified": true
    },
    {
      "id": "rel-activity-to-resource-logs",
      "from": "azure-activity-log",
      "to": "azure-resource-logs",
      "type": "Pivot",
      "description": "A control-plane operation on a resource points to that resource's data-plane activity, which only Resource Logs record.",
      "pivot_on": ["Resource ID", "Time window"],
      "source_ids": ["src-activity-log", "src-resource-logs"],
      "verified": true
    },
    {
      "id": "rel-diagsettings-govern-resource-logs",
      "from": "azure-diagnostic-settings",
      "to": "azure-resource-logs",
      "type": "Collection governed by",
      "description": "Resource Logs exist for a period only if a diagnostic setting routed the relevant categories during that period.",
      "pivot_on": ["Resource ID", "Log category"],
      "source_ids": ["src-resource-logs", "src-kv-monitor"],
      "verified": true
    },
    {
      "id": "rel-diagsettings-to-workspace",
      "from": "azure-diagnostic-settings",
      "to": "log-analytics-workspace",
      "type": "Routed to",
      "description": "A diagnostic setting names the workspace (and collection mode) where routed logs land.",
      "pivot_on": ["Workspace resource ID", "Collection mode"],
      "source_ids": ["src-resource-logs"],
      "verified": true
    },
    {
      "id": "rel-resource-logs-keyvault",
      "from": "azure-resource-logs",
      "to": "key-vault-audit-event",
      "type": "Specializes",
      "description": "Key Vault AuditEvent is a Resource Log category.",
