      "description": "StorageRead, StorageWrite, and StorageDelete are Resource Log categories.",
      "pivot_on": [],
      "source_ids": ["src-blob-monitor-reference"],
      "verified": true
    },
    {
      "id": "rel-resource-logs-firewall",
      "from": "azure-resource-logs",
      "to": "azure-firewall-logs",
      "type": "Specializes",
      "description": "Azure Firewall logs are Resource Log categories.",
      "pivot_on": [],
      "source_ids": ["src-fw-monitor"],
      "verified": true
    },
    {
      "id": "rel-resource-logs-waf",
      "from": "azure-resource-logs",
      "to": "appgw-waf-logs",
      "type": "Specializes",
      "description": "The Application Gateway WAF log is a Resource Log category.",
      "pivot_on": [],
